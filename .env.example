# Copie para `.env` (ignorado pelo git) e preencha ali — NÃO preencha aqui,
# este arquivo é versionado.

# ===== RetroAchievements =====
# Usado só por `npm run cheevos:sync`, na sua máquina — nunca vai pro bundle
# nem pro site publicado.

# Seu usuário no https://retroachievements.org
RA_USERNAME=

# Web API Key em https://retroachievements.org/settings
RA_API_KEY=

# ===== Firebase =====
# Configurações do projeto > Seus apps > SDK setup, no console do Firebase.
# Prefixo PUBLIC_ de propósito: o Astro expõe essas no bundle do navegador
# porque o SDK client-side do Firebase precisa delas em runtime. Não são
# segredo — a segurança é feita pelas Firestore Rules (firestore.rules).
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=
PUBLIC_FIREBASE_PROJECT_ID=
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
PUBLIC_FIREBASE_APP_ID=
PUBLIC_FIREBASE_MEASUREMENT_ID=

# E-mail do único usuário com permissão de escrita. Tem que bater com o que
# está fixo em firestore.rules. PUBLIC_ porque o client só usa isso pra
# decidir se mostra o botão de editar (UX) — quem decide de verdade quem
# pode escrever é o Firestore via token do Google, não essa comparação no
# navegador.
PUBLIC_ADMIN_EMAIL=
