---
// Ícone de pokébola — não existe no Lucide, então é o único ícone "à mão"
// do projeto. Desenhado no mesmo grid 24x24 / stroke 2 / round do resto do
// set, pra combinar visualmente com @lucide/astro em qualquer lugar que
// precisar (hoje: barra de captura da pokédex na lista de jogos).
interface Props {
  size?: number;
  class?: string;
}

const { size = 24, class: className } = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={`pokeball ${className ?? ''}`}
  aria-hidden="true">
  <circle cx="12" cy="12" r="10" />
  <path d="M2 12h6.5" />
  <path d="M15.5 12H22" />
  <circle cx="12" cy="12" r="2.5" />
</svg>
