---
import '../styles/global.css';
import { withBase } from '../lib/base';
import { pwaInfo } from 'virtual:pwa-info';

interface Props {
  title?: string;
  description?: string;
}
const { title = 'Minha Agenda', description = 'Agenda pessoal em Markdown, offline.' } = Astro.props;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="description" content={description} />

    <!-- PWA / iOS (iPad 10 + iPhone) -->
    <meta name="theme-color" content="#f5f5f7" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#000000" media="(prefers-color-scheme: dark)" />
    <meta name="mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-status-bar-style" content="default" />
    <meta name="apple-mobile-web-app-title" content="Agenda" />
    <meta name="format-detection" content="telephone=no" />

    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <link rel="apple-touch-icon" href={withBase('icons/apple-touch-icon.png')} />
    <title>{title}</title>
    {pwaInfo && <Fragment set:html={pwaInfo.webManifest.linkTag} />}
  </head>
  <body>
    <header class="topbar">
      <div class="wrap">
        <a class="brand" href={withBase('')}>
          <span class="dot"></span>
          <span class="brand-name">Agenda</span>
        </a>
        <span class="spacer"></span>
        <span id="pwa-status" class="hint"></span>
        <button id="btn-refresh" class="icon-btn" type="button" title="Atualizar o app" aria-label="Atualizar o app">
          <svg viewBox="0 0 24 24" width="19" height="19" aria-hidden="true">
            <path
              d="M20 12a8 8 0 1 1-2.34-5.66M20 4v4h-4"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round" />
          </svg>
        </button>
      </div>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="foot">
      <div class="wrap">
        Feito com Markdown · funciona offline · seus dados ficam no dispositivo
      </div>
    </footer>

    <script>
      import { registerSW } from 'virtual:pwa-register';
      import { initSync } from '../lib/init-sync';

      const status = document.getElementById('pwa-status');
      const btn = document.getElementById('btn-refresh') as HTMLButtonElement | null;

      registerSW({
        immediate: true,
        onOfflineReady() {
          if (status) {
            status.textContent = 'Offline pronto';
            status.className = 'hint offline-ready';
          }
        },
      });

      function flash(text: string) {
        if (!status) return;
        status.textContent = text;
        status.className = 'hint offline-ready';
      }

      // Botão "atualizar": em vez de só pedir pro SW atual buscar uma versão
      // nova (que às vezes não é suficiente — SW órfão de outra versão do
      // scope, cache antigo que o precache não limpou), derruba TUDO que
      // pode estar servindo conteúdo velho: desregistra todo service worker
      // deste scope, apaga todo Cache Storage, e só then recarrega. Isso
      // sempre resulta em HTML/JS/CSS frescos da rede, nunca uma tela velha.
      btn?.addEventListener('click', async () => {
        if (btn.classList.contains('busy')) return;
        btn.classList.add('busy');
        flash('atualizando…');

        try {
          if ('serviceWorker' in navigator) {
            const regs = await navigator.serviceWorker.getRegistrations();
            await Promise.all(regs.map((r) => r.unregister()));
          }
          if ('caches' in window) {
            const names = await caches.keys();
            await Promise.all(names.map((n) => caches.delete(n)));
          }
          // Limpa dados de usuário mas preserva token do gist
          if ('indexedDB' in window) {
            await new Promise<void>((resolve) => {
              const req = indexedDB.open('minha-agenda');
              req.onsuccess = () => {
                try {
                  const db = req.result;
                  const tx = db.transaction(['checks', 'notes', 'prices', 'pokemonSaves'], 'readwrite');
                  // Limpa stores de dados (checks, notes, prices, pokemonSaves)
                  // mas deixa 'meta' intacto (contém gh-token e gist-id)
                  tx.objectStore('checks').clear();
                  tx.objectStore('notes').clear();
                  tx.objectStore('prices').clear();
                  tx.objectStore('pokemonSaves').clear();
                  tx.oncomplete = () => {
                    db.close();
                    resolve();
                  };
                } catch {
                  resolve();
                }
              };
              req.onerror = () => resolve();
            });
          }
        } catch {
          // segue pro reload mesmo se algo falhar aqui — melhor recarregar
          // sem ter limpado tudo do que travar no botão de update
        }
        // location.reload() poderia ainda pegar HTML do bfcache/HTTP cache;
        // força busca de rede de verdade trocando a URL (cache-bust).
        const u = new URL(location.href);
        u.searchParams.set('_refresh', String(Date.now()));
        location.replace(u.toString());
      });

      // Inicializa o sync por gist (inerte se não houver token neste aparelho)
      initSync();
    </script>
  </body>
</html>
