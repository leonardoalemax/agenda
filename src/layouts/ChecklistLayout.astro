---
import BaseLayout from './BaseLayout.astro';
import { withBase } from '../lib/base';
import type { CollectionEntry } from 'astro:content';

interface Props { entry: CollectionEntry<'agenda'> }
const { entry } = Astro.props;
const { title, date, tags, summary, progress } = entry.data;
const dateStr = date
  ? new Intl.DateTimeFormat('pt-BR', { dateStyle: 'long', timeZone: 'UTC' }).format(date)
  : null;
---

<BaseLayout title={title} description={summary}>
  <a class="back" href={withBase('')}>← agenda</a>
  <header class="doc-header">
    <span class="badge checklist">checklist</span>
    <h1>{title}</h1>
    <div class="meta">
      {dateStr && <span>{dateStr}</span>}
      {tags.length > 0 && (
        <span class="tags">{tags.map((t) => <span class="tag">#{t}</span>)}</span>
      )}
    </div>
  </header>

  {progress && (
    <div class="progress">
      <div class="track"><span data-progress-bar></span></div>
      <div class="label" data-progress-label>carregando…</div>
    </div>
  )}

  <article class="content" data-checklist data-slug={entry.id}>
    <slot />
  </article>

  <p class="hint">Os itens marcados ficam salvos neste dispositivo automaticamente.</p>

  <script>
    import { initChecklists } from '../lib/checklist';
    initChecklists();
  </script>
</BaseLayout>
