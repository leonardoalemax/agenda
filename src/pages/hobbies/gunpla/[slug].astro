---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { withBase } from '../../../lib/base';
import { formatYen, formatBRL, yenToBRL, shortName } from '../../../lib/gunpla';

export async function getStaticPaths() {
  const kits = await getCollection('gunpla');
  return kits.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const { name, grade, code, priceYen, image, tags } = entry.data;
---

<BaseLayout title={name} description={`${grade} ${code} — ${formatYen(priceYen)}`}>
  <a class="back" href={withBase('hobbies/gunpla')}>← wishlist</a>

  <div class="kit-hero">
    <div class="hero-img"><img src={withBase(image)} alt={name} /></div>
    <div class="hero-meta">
      <div class="row" style="gap:8px;">
        <span class={`badge grade grade-${(grade || '').toLowerCase()}`}>{grade}</span>
        <span class="badge">{entry.data.scale}</span>
        {tags.includes('wishlist') && <span class="badge gunpla">wishlist</span>}
      </div>
      <h1>{shortName(name)}</h1>
      <div class="kit-price big">
        <span class="yen">{formatYen(priceYen)}</span>
        <span class="brl">{formatBRL(yenToBRL(priceYen))}</span>
      </div>
    </div>
  </div>

  <article class="content">
    <Content />
  </article>
</BaseLayout>
