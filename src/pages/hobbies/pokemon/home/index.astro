---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import { withBase } from '../../../../lib/base';
import { allGenerations, generationLabel, gameName, dexForGame, coverPath, platformsForGame } from '../../../../lib/pokemon';

const gens = allGenerations();

// Mesmo mapa game -> metadados usado em /saves/ — o client usa pra montar o
// cabeçalho de cada save transferido (nome do jogo, capa) sem reimportar os
// JSONs de dados no bundle desta página.
const gameIndex = Object.fromEntries(
  gens.flatMap((gen) =>
    gen.games.map((g) => [
      g.slug,
      {
        name: gameName(g.slug),
        generation: generationLabel(gen),
        total: dexForGame(gen.name, g.slug).length,
        cover: coverPath(g.slug),
        platforms: platformsForGame(gen.name, g.slug),
      },
    ]),
  ),
);
---

<BaseLayout title="Pokémon · HOME" description="Pokémon transferidos pro HOME, por save.">
  <a class="back" href={withBase('hobbies/pokemon')}>← jogos</a>

  <header class="doc-header">
    <span class="badge pokemon">pokémon</span>
    <h1>HOME</h1>
    <p class="hint" style="margin:.2rem 0 0;">
      A transferência é por save inteiro — marque um save como "Movido pro HOME" na página dele pra ele aparecer aqui.
    </p>
  </header>

  <nav class="subnav">
    <a class="subnav-item" href={withBase('hobbies/pokemon')}>Jogos</a>
    <a class="subnav-item" href={withBase('hobbies/pokemon/saves')}>Saves</a>
    <span class="subnav-item active">HOME</span>
  </nav>

  <p class="hint" data-home-empty hidden>
    Nenhum save transferido pro HOME ainda. Vá num save e marque "Movido pro HOME".
  </p>

  <div data-home-list></div>

  <script define:vars={{ gameIndexJson: JSON.stringify(gameIndex) }}>
    window.__pokemonGameIndex = JSON.parse(gameIndexJson);
  </script>
  <script>
    import { initPokemonHomePage } from '../../../../lib/pokemon-client';
    initPokemonHomePage();
  </script>
</BaseLayout>

<style>
  :global(.home-save) { margin-bottom: var(--s-xl); }
  :global(.home-save-header) {
    display: flex; align-items: center; gap: var(--s-md); margin-bottom: var(--s-md);
  }
  :global(.home-save-cover) {
    width: 48px; height: 48px; object-fit: contain; background: var(--surface-2);
    border-radius: var(--r-sm); display: block; flex: none;
    filter: drop-shadow(var(--product-shadow));
  }
  :global(.home-save-info) { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
  :global(.home-save-info strong) { font-size: 16px; letter-spacing: -0.32px; }
  :global(.home-save-info a) { color: inherit; }
  :global(.home-save-info a:hover) { color: var(--link); }
  :global(.home-save-progress) { flex: none; font-size: 13px; color: var(--muted); font-variant-numeric: tabular-nums; }

  /* ===== caixas: layout do HOME é sempre o mesmo (6×5 = 30), nunca o do
     jogo de origem — mesmo padrão visual da página do save, sem clique.
     3 níveis de contraste: fundo da página (--bg) → caixa (--surface) →
     card de cada pokémon (--surface-2). ===== */
  :global(.home-box) {
    margin-bottom: var(--s-lg); overflow-x: auto;
    background: var(--surface); border: 1px solid var(--hairline);
    border-radius: var(--r-lg); padding: var(--s-md);
  }
  :global(.home-box-title) {
    font-size: 13px; font-weight: 600; color: var(--muted);
    text-transform: uppercase; letter-spacing: 0.04em; margin: 0 0 var(--s-sm);
  }
  :global(.home-box-items) {
    list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-sm);
    grid-template-columns: repeat(var(--cols), minmax(58px, 1fr));
    grid-auto-rows: 1fr; min-width: min-content;
  }
  :global(.home-mon) {
    display: flex; flex-direction: column; align-items: center; gap: 2px;
    padding: var(--s-sm) 4px; text-align: center; border-radius: var(--r-md);
    background: var(--surface-2);
  }
  :global(.home-mon-sprite-wrapper) {
    position: relative; display: inline-block;
  }
  :global(.home-mon-sprite) {
    width: 56px; height: 56px; object-fit: contain; display: block;
    image-rendering: pixelated;
    opacity: .35; filter: grayscale(1);
  }
  :global(.home-mon-origin-mark) {
    position: absolute; bottom: -2px; right: -2px;
    width: 14px; height: 14px;
    padding: 1px; box-sizing: border-box;
  }
  :global(.home-mon-num) { font-size: 11px; color: var(--muted); font-variant-numeric: tabular-nums; }
  :global(.home-mon-name) { font-size: 11px; line-height: 1.2; overflow-wrap: anywhere; }
  :global(.home-mon.caught .home-mon-sprite) { opacity: 1; filter: none; }
  :global(.home-mon.caught) { background: color-mix(in srgb, var(--accent) 12%, var(--surface-2)); }
  :global(.home-mon.caught .home-mon-name) { font-weight: 600; }

  /* Vaga vazia: caixa do HOME sempre com 30 slots, mesmo quando o save tem
     menos pokémon que isso — completa em branco em vez de grade torta. */
  :global(.home-mon.empty) {
    border: 1px dashed var(--hairline); border-radius: var(--r-md);
    background: var(--surface-2); opacity: .5; aspect-ratio: 1 / 1;
  }

  @media (max-width: 600px) {
    :global(.home-box-items) {
      grid-template-columns: repeat(var(--cols), minmax(48px, 1fr));
      gap: 3px;
    }
    :global(.home-mon-sprite) { width: 48px; height: 48px; }
    :global(.home-mon) { padding: 6px 2px; }
    :global(.home-mon-num),
    :global(.home-mon-name) { display: none; }
  }
</style>
