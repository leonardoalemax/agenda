---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PokeballIcon from '../../../components/PokeballIcon.astro';
import { Trophy, Badge, Disc, Cloud, ChevronRight } from '@lucide/astro';
import { withBase } from '../../../lib/base';
import { allGenerations, generationLabel, gameName, mediaForGame, mediaLabel, coverPath, retroGameFor, transferSupportFor, dexForGame, marcosForGame } from '../../../lib/pokemon';
import { cheevosGame } from '../../../lib/cheevos';

const gens = allGenerations();

// Progresso de conquistas do jogo, quando ele existe no RetroAchievements.
// Dois dados diferentes se cruzam aqui:
//  - o mapa (pokemon:ra-map) diz *se* o jogo tem conquistas e quantas;
//  - o sync (cheevos:sync) diz quantas *eu* fiz — e só lista jogo que joguei.
// Por isso o total cai pro mapa: jogo com conquistas que nunca toquei aparece
// como 0/N em vez de sumir.
function cheevosFor(slug: string) {
  const retro = retroGameFor(slug);
  if (!retro) return null;

  const played = cheevosGame(retro.raId);
  const total = played?.total || retro.achievements;
  if (!total) return null;

  const earned = played?.earned ?? 0;
  return { earned, total, pct: Math.round((earned / total) * 100) };
}

const sections = gens.map((gen) => ({
  gen,
  games: gen.games.map((g) => ({
    slug: g.slug,
    name: gameName(g.slug),
    media: mediaForGame(gen.name, g.slug),
    cheevos: cheevosFor(g.slug),
    transfer: transferSupportFor(g.slug),
    dexTotal: dexForGame(gen.name, g.slug).length,
    marcosTotal: marcosForGame(g.slug).length,
  })),
}));

const totalGames = sections.reduce((s, x) => s + x.games.length, 0);
const withCheevos = sections.reduce((s, x) => s + x.games.filter((g) => g.cheevos).length, 0);
---

<BaseLayout title="Pokémon · Jogos" description="Quais jogos eu tenho, físico ou digital.">
  <a class="back" href={withBase('')}>← agenda</a>

  <header class="doc-header">
    <span class="badge pokemon">pokémon</span>
    <h1>Jogos</h1>
    <p class="hint" style="margin:.2rem 0 0;">
      {totalGames} jogos · marque físico e/ou digital · a pokédex fica nos <a href={withBase('hobbies/pokemon/saves')}>saves</a>
      {withCheevos > 0 && (
        <> · {withCheevos} com <a href={withBase('hobbies/cheevos')}>conquistas</a></>
      )}
    </p>
  </header>

  <nav class="subnav">
    <span class="subnav-item active">Jogos</span>
    <a class="subnav-item" href={withBase('hobbies/pokemon/saves')}>Saves</a>
    <a class="subnav-item" href={withBase('hobbies/pokemon/home')}>HOME</a>
  </nav>

  <span class="filters-label">Filtrar</span>
  <div class="transfer-filters" role="group" aria-label="Filtrar jogos">
    <button type="button" class="filter-chip" data-transfer-filter="bank" aria-pressed="false">Bank</button>
    <button type="button" class="filter-chip" data-transfer-filter="home" aria-pressed="false">HOME</button>
    <button type="button" class="filter-chip" data-transfer-filter="transport" aria-pressed="false">Transporte</button>
    <button type="button" class="filter-chip" data-transfer-filter="cheevos" aria-pressed="false">Conquistas</button>
    <button type="button" class="filter-chip" data-transfer-filter="completed" aria-pressed="false">Finalizados</button>
  </div>
  <p class="hint filter-empty" data-filter-empty hidden>Nenhum jogo atende aos filtros selecionados.</p>

  {sections.map(({ gen, games }) => (
    <section class="gen" data-gen>
      <h2 class="section-title">
        {generationLabel(gen)}
        <small class="gen-region">{gen.region}</small>
      </h2>

      <div class="game-list">
        {games.map((game) => (
          <article
            class="game"
            data-game={game.slug}
            data-href={withBase(`hobbies/pokemon/saves/?game=${game.slug}`)}
            data-bank={String(game.transfer.bank)}
            data-home={String(game.transfer.home)}
            data-transport={String(game.transfer.transport)}
            data-cheevos={String(Boolean(game.cheevos))}
            data-completed="false">
            <img
              class="game-cover"
              src={withBase(coverPath(game.slug))}
              alt=""
              width="400"
              height="400"
              loading="lazy"
              decoding="async" />
            <h3 class="game-name">{game.name}</h3>
            <div class="media-row">
              {(['physical', 'digital'] as const).map((m) =>
                game.media.includes(m) ? (
                  <label class="media-toggle" data-media={m} title={mediaLabel(m)}>
                    <input type="checkbox" class="sr-only" data-owned={`${game.slug}::${m}`} />
                    {m === 'physical' ? <Disc size={18} /> : <Cloud size={18} />}
                  </label>
                ) : (
                  <span class="media-toggle media-toggle-empty" aria-hidden="true"></span>
                ),
              )}
            </div>
            <div class="game-progress">
              {game.cheevos && (
                <div
                  class={`progress-row${game.cheevos.earned === 0 ? ' empty' : ''}`}
                  title={`${game.cheevos.earned} de ${game.cheevos.total} conquistas no RetroAchievements`}>
                  <Trophy size={16} />
                  <div
                    class="progress"
                    role="progressbar"
                    aria-label={`Conquistas de ${game.name}`}
                    aria-valuemin="0"
                    aria-valuemax="100"
                    aria-valuenow={game.cheevos.pct}>
                    <span style={`width:${game.cheevos.pct}%`}></span>
                  </div>
                  <span class="progress-label">{game.cheevos.earned}/{game.cheevos.total}</span>
                </div>
              )}
              {game.marcosTotal > 0 && (
                <div class="progress-row empty" data-marcos-progress data-marcos-total={game.marcosTotal}>
                  <Badge size={16} />
                  <div
                    class="progress"
                    role="progressbar"
                    aria-label={`Marcos de ${game.name}`}
                    aria-valuemin="0"
                    aria-valuemax="100"
                    aria-valuenow="0"
                    data-marcos-track>
                    <span data-marcos-bar></span>
                  </div>
                  <span class="progress-label" data-marcos-label>0/{game.marcosTotal}</span>
                </div>
              )}
              <div class="progress-row empty" data-dex-progress data-dex-total={game.dexTotal}>
                <PokeballIcon size={16} />
                <div
                  class="progress"
                  role="progressbar"
                  aria-label={`Pokédex de ${game.name}`}
                  aria-valuemin="0"
                  aria-valuemax="100"
                  aria-valuenow="0"
                  data-dex-track>
                  <span data-dex-bar></span>
                </div>
                <span class="progress-label" data-dex-label>0/{game.dexTotal}</span>
              </div>
            </div>
            <a class="game-saves-link" href={withBase(`hobbies/pokemon/saves/?game=${game.slug}`)} aria-label={`Ver saves de ${game.name}`}>
              <ChevronRight size={20} />
            </a>
          </article>
        ))}
      </div>
    </section>
  ))}

  <script>
    import { initPokemonGames, initPokemonGameFilters, initPokemonGameCards } from '../../../lib/pokemon-client';
    initPokemonGames();
    initPokemonGameFilters();
    initPokemonGameCards();
  </script>
</BaseLayout>

<style>
  .filters-label {
    display: block; font-size: 12px; font-weight: 600; text-transform: uppercase;
    letter-spacing: 0.03em; color: var(--muted); margin-bottom: 8px;
  }
  .transfer-filters { display: flex; flex-wrap: wrap; gap: var(--s-sm); margin-bottom: var(--s-md); }
  .filter-chip {
    padding: 5px 13px; border-radius: var(--r-pill); font-size: 13px; font-weight: 500;
    color: var(--muted); background: transparent; border: 1px solid var(--hairline);
    cursor: pointer; transition: border-color .15s ease, background-color .15s ease, color .15s ease;
  }
  .filter-chip:hover { border-color: var(--accent); }
  .filter-chip:focus-visible { outline: 2px solid var(--accent-focus); outline-offset: 2px; }
  .filter-chip[aria-pressed="true"] {
    color: var(--on-accent); background: var(--accent); border-color: var(--accent);
  }
  .filter-empty { margin: var(--s-md) 0; }

  .gen { margin-top: var(--s-lg); }
  .gen[hidden] { display: none; }
  .gen-region {
    font-size: 13px; font-weight: 400; color: var(--muted);
    text-transform: capitalize; margin-left: 8px; letter-spacing: 0;
  }

  .game-list { display: flex; flex-direction: column; gap: var(--s-sm); }

  /* Desktop: uma linha só, tudo centralizado no eixo vertical. O card
     inteiro navega pro save (initPokemonGameCards) — só os toggles e o
     link explícito ficam de fora disso. A coluna de progresso é o único
     item flexível: come o espaço que sobrar entre os elementos de largura
     fixa; sem ela, "ver saves" (margin-left: auto) assume esse papel e
     continua preso na borda direita. */
  .game {
    border: 1px solid var(--hairline); border-radius: var(--r-lg);
    background: var(--surface); padding: var(--s-sm) var(--s-md);
    display: flex; align-items: center; gap: var(--s-md);
    cursor: pointer; transition: border-color .15s ease;
  }
  .game:hover { border-color: color-mix(in srgb, var(--accent) 45%, var(--hairline)); }
  .game[hidden] { display: none; }
  .game-cover {
    width: 48px; height: 48px; object-fit: contain; background: var(--surface-2);
    border-radius: var(--r-sm); display: block; flex: none;
    filter: drop-shadow(var(--product-shadow));
  }
  .game-name {
    margin: 0; font-size: 15px; letter-spacing: -0.374px;
    min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    flex: 0 1 200px;
  }
  /* Toggle físico/digital: só o ícone é clicável — o checkbox real fica
     visualmente escondido (.sr-only) mas continua no DOM pra teclado/leitor
     de tela. Cinza solto = desmarcado, azul = marcado; sem caixa, sem texto.
     Sempre 2 caixas de 32px nessa fileira (físico, digital), existindo ou
     não pra aquele jogo — um slot vazio ocupa o mesmo lugar em vez de
     encolher a fileira, senão a barra de progresso ao lado (que é quem
     sobra o espaço) começaria numa posição diferente em cada card. */
  .media-row { display: flex; align-items: center; gap: 2px; flex: none; }
  .media-toggle {
    position: relative; display: flex; align-items: center; justify-content: center;
    width: 32px; height: 32px; border-radius: var(--r-sm);
    color: var(--muted); cursor: pointer;
    transition: color .15s ease, background-color .15s ease;
  }
  .media-toggle:hover { background: var(--surface-2); }
  .media-toggle:has(input:checked) { color: var(--accent); }
  .media-toggle:has(input:focus-visible) { outline: 2px solid var(--accent-focus); outline-offset: 2px; }
  .media-toggle-empty { cursor: default; pointer-events: none; }

  .game-saves-link {
    display: flex; align-items: center; justify-content: center;
    color: var(--muted); flex: none; margin-left: auto;
  }
  .game-saves-link:hover { color: var(--link); }

  /* Progresso: até 3 barras empilhadas (conquistas + marcos + pokédex),
     cada uma só existe se o jogo tiver o dado — sempre centralizadas no
     espaço vertical do card, ocupando o resto da linha. */
  .game-progress {
    flex: 1 1 0; min-width: 0;
    display: flex; flex-direction: column; justify-content: center; gap: 4px;
  }
  .progress-row { display: flex; align-items: center; gap: 6px; width: 100%; }
  .progress-row :global(svg) { flex: none; color: var(--muted); }
  .progress-row .progress {
    flex: 1; height: 5px; background: var(--surface-2);
    border-radius: var(--r-pill); overflow: hidden;
  }
  .progress-row .progress span { display: block; height: 100%; background: var(--accent); }
  .progress-label {
    font-size: 12px; color: var(--muted); white-space: nowrap;
    font-variant-numeric: tabular-nums; flex: none;
  }
  /* Nunca jogado / nunca capturado fica discreto: é oferta, não pendência. */
  .progress-row.empty { opacity: .55; }

  @media (max-width: 600px) {
    .game {
      display: grid; grid-template-columns: 48px 1fr auto;
      grid-template-rows: auto auto auto; align-items: center;
    }
    .game-cover { grid-column: 1; grid-row: 1 / 4; }
    .game-name { grid-column: 2; grid-row: 1; flex: unset; }
    .media-row { grid-column: 2; grid-row: 2; }
    .game-progress {
      grid-column: 2; grid-row: 3;
      flex: unset; min-width: 0; padding-top: var(--s-xs);
    }
    .game-saves-link {
      grid-column: 3; grid-row: 1 / 4; align-self: center; margin-left: 0;
    }
  }
</style>
