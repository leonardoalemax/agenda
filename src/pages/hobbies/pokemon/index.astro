---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Icon from '../../../components/Icon.astro';
import { withBase } from '../../../lib/base';
import { allGenerations, generationLabel, gameName, mediaForGame, mediaLabel, coverPath, retroGameFor, transferSupportFor } from '../../../lib/pokemon';
import { cheevosGame } from '../../../lib/cheevos';

const gens = allGenerations();

// Progresso de conquistas do jogo, quando ele existe no RetroAchievements.
// Dois dados diferentes se cruzam aqui:
//  - o mapa (pokemon:ra-map) diz *se* o jogo tem conquistas e quantas;
//  - o sync (cheevos:sync) diz quantas *eu* fiz — e só lista jogo que joguei.
// Por isso o total cai pro mapa: jogo com conquistas que nunca toquei aparece
// como 0/N em vez de sumir.
function cheevosFor(slug: string) {
  const retro = retroGameFor(slug);
  if (!retro) return null;

  const played = cheevosGame(retro.raId);
  const total = played?.total || retro.achievements;
  if (!total) return null;

  const earned = played?.earned ?? 0;
  return { earned, total, pct: Math.round((earned / total) * 100) };
}

const sections = gens.map((gen) => ({
  gen,
  games: gen.games.map((g) => ({
    slug: g.slug,
    name: gameName(g.slug),
    media: mediaForGame(gen.name, g.slug),
    cheevos: cheevosFor(g.slug),
    transfer: transferSupportFor(g.slug),
  })),
}));

const totalGames = sections.reduce((s, x) => s + x.games.length, 0);
const withCheevos = sections.reduce((s, x) => s + x.games.filter((g) => g.cheevos).length, 0);
---

<BaseLayout title="Pokémon · Jogos" description="Quais jogos eu tenho, físico ou digital.">
  <a class="back" href={withBase('')}>← agenda</a>

  <header class="doc-header">
    <span class="badge pokemon">pokémon</span>
    <h1>Jogos</h1>
    <p class="hint" style="margin:.2rem 0 0;">
      {totalGames} jogos · marque físico e/ou digital · a pokédex fica nos <a href={withBase('hobbies/pokemon/saves')}>saves</a>
      {withCheevos > 0 && (
        <> · {withCheevos} com <a href={withBase('hobbies/cheevos')}>conquistas</a></>
      )}
    </p>
  </header>

  <nav class="subnav">
    <span class="subnav-item active">Jogos</span>
    <a class="subnav-item" href={withBase('hobbies/pokemon/saves')}>Saves</a>
    <a class="subnav-item" href={withBase('hobbies/pokemon/home')}>HOME</a>
  </nav>

  <div class="transfer-filters" role="group" aria-label="Filtrar jogos">
    <button type="button" class="filter-chip" data-transfer-filter="bank" aria-pressed="false">Bank</button>
    <button type="button" class="filter-chip" data-transfer-filter="home" aria-pressed="false">HOME</button>
    <button type="button" class="filter-chip" data-transfer-filter="transport" aria-pressed="false">Transporte</button>
    <button type="button" class="filter-chip" data-transfer-filter="cheevos" aria-pressed="false">Conquistas</button>
    <button type="button" class="filter-chip" data-transfer-filter="completed" aria-pressed="false">Finalizados</button>
  </div>
  <p class="hint filter-empty" data-filter-empty hidden>Nenhum jogo atende aos filtros selecionados.</p>

  {sections.map(({ gen, games }) => (
    <section class="gen" data-gen>
      <h2 class="section-title">
        {generationLabel(gen)}
        <small class="gen-region">{gen.region}</small>
      </h2>

      <div class="game-list">
        {games.map((game) => (
          <article
            class="game"
            data-bank={String(game.transfer.bank)}
            data-home={String(game.transfer.home)}
            data-transport={String(game.transfer.transport)}
            data-cheevos={String(Boolean(game.cheevos))}
            data-completed="false">
            <img
              class="game-cover"
              src={withBase(coverPath(game.slug))}
              alt=""
              width="400"
              height="400"
              loading="lazy"
              decoding="async" />
            <div class="game-title-row">
              <h3>{game.name}</h3>
              <span class="completed-badge" data-completed-badge={game.slug} hidden title="Save completo (100% pokédex)">
                <Icon name="monitor-check" size={14} />
                <span>completo</span>
              </span>
            </div>
            <div class="media-row">
              {game.media.map((m) => (
                <label class="media-toggle" data-media={m}>
                  <input type="checkbox" data-owned={`${game.slug}::${m}`} />
                  {m === 'physical' ? (
                    <svg class="media-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                      <circle cx="8" cy="8" r="6.5" stroke="currentColor" stroke-width="1.3"/>
                      <circle cx="8" cy="8" r="2" fill="currentColor"/>
                    </svg>
                  ) : (
                    <svg class="media-icon" width="16" height="16" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
                      <path d="M4.5 12.5a2.75 2.75 0 0 1-.4-5.47 3.5 3.5 0 0 1 6.78-1.62A2.75 2.75 0 0 1 11.5 12.5h-7Z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/>
                    </svg>
                  )}
                  <span>{mediaLabel(m)}</span>
                </label>
              ))}
            </div>
            {game.cheevos && (
              <div
                class={`game-cheevos${game.cheevos.earned === 0 ? ' empty' : ''}`}
                title={`${game.cheevos.earned} de ${game.cheevos.total} conquistas no RetroAchievements`}>
                <div class="game-cheevos-content">
                  <Icon name="trophy" size={16} />
                  <div
                    class="progress"
                    role="progressbar"
                    aria-label={`Conquistas de ${game.name}`}
                    aria-valuemin="0"
                    aria-valuemax="100"
                    aria-valuenow={game.cheevos.pct}>
                    <span style={`width:${game.cheevos.pct}%`}></span>
                  </div>
                  <span class="game-cheevos-label">{game.cheevos.earned}/{game.cheevos.total}</span>
                </div>
              </div>
            )}
            <a class="game-saves-link" href={withBase(`hobbies/pokemon/saves/?game=${game.slug}`)}>
              <span>ver saves</span> ›
            </a>
          </article>
        ))}
      </div>
    </section>
  ))}

  <script>
    import { initPokemonGames, initPokemonGameFilters } from '../../../lib/pokemon-client';
    initPokemonGames();
    initPokemonGameFilters();
  </script>
</BaseLayout>

<style>
  .subnav { display: flex; gap: var(--s-sm); margin: var(--s-md) 0 var(--s-lg); }
  .subnav-item {
    padding: 6px 14px; border-radius: var(--r-pill); font-size: 14px; font-weight: 500;
    color: var(--muted); border: 1px solid var(--hairline);
  }
  .subnav-item:hover { text-decoration: none; border-color: var(--accent); }
  .subnav-item.active { color: var(--on-accent); background: var(--accent); border-color: var(--accent); }

  .transfer-filters { display: flex; gap: var(--s-sm); margin-bottom: var(--s-md); }
  .filter-chip {
    padding: 6px 14px; border-radius: var(--r-pill); font-size: 14px; font-weight: 500;
    color: var(--muted); background: var(--surface); border: 1px solid var(--hairline);
    cursor: pointer;
  }
  .filter-chip:hover { border-color: var(--accent); }
  .filter-chip[aria-pressed="true"] {
    color: var(--on-accent); background: var(--accent); border-color: var(--accent);
  }
  .filter-empty { margin: var(--s-md) 0; }

  .gen { margin-top: var(--s-lg); }
  .gen[hidden] { display: none; }
  .gen-region {
    font-size: 13px; font-weight: 400; color: var(--muted);
    text-transform: capitalize; margin-left: 8px; letter-spacing: 0;
  }

  .game-list { display: flex; flex-direction: column; gap: var(--s-sm); }
  .game {
    border: 1px solid var(--hairline); border-radius: var(--r-lg);
    background: var(--surface); padding: var(--s-sm) var(--s-md);
    display: grid; grid-template-columns: 48px 1fr 160px 50px;
    gap: var(--s-md); align-items: center;
  }
  .game[hidden] { display: none; }
  .game-cover {
    width: 48px; height: 48px; object-fit: contain; background: var(--surface-2);
    border-radius: var(--r-sm); display: block; flex: none; grid-row: 1 / 3;
  }
  .game-title-row {
    display: flex; align-items: center; gap: 6px; min-width: 0;
    grid-column: 2; grid-row: 1;
  }
  .game h3 {
    margin: 0; font-size: 15px; letter-spacing: -0.374px;
    min-width: 0; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    flex: 1;
  }
  .completed-badge {
    flex: none; display: flex; align-items: center; gap: 3px;
    font-size: 11px; font-weight: 600; letter-spacing: 0.02em;
    color: #10b981; background: color-mix(in srgb, #10b981 12%, transparent);
    border: 1px solid color-mix(in srgb, #10b981 35%, transparent);
    border-radius: var(--r-pill); padding: 2px 7px;
  }
  .completed-badge :global(.icon) { color: inherit; }
  .media-row {
    display: flex; gap: var(--s-sm); flex-wrap: nowrap;
    grid-column: 2; grid-row: 2;
  }
  .media-toggle { display: flex; align-items: center; gap: 4px; cursor: pointer; font-size: 13px; min-height: auto; }
  .media-toggle input { width: 18px; height: 18px; accent-color: var(--accent); cursor: pointer; flex: none; }
  .media-icon { flex: none; color: var(--muted); }
  .media-toggle:has(input:checked) .media-icon { color: var(--accent); }
  .game-saves-link {
    font-size: 13px; color: var(--muted); white-space: nowrap;
    grid-column: 4; grid-row: 1 / 3;
  }
  .game-saves-link:hover { color: var(--link); }

  /* Conquistas (ícone + barra + label): ~40% de 160px */
  .game-cheevos {
    grid-column: 3; grid-row: 1 / 3;
    display: flex; align-items: center; gap: 6px; height: 100%;
  }
  .game-cheevos-content {
    display: flex; align-items: center; gap: 6px; width: 100%;
  }
  .game-cheevos :global(.icon) { flex: none; color: var(--muted); }
  .game-cheevos .progress {
    flex: 1; height: 5px; background: var(--surface-2);
    border-radius: var(--r-pill); overflow: hidden;
  }
  .game-cheevos .progress span { display: block; height: 100%; background: var(--accent); }
  .game-cheevos-label {
    font-size: 12px; color: var(--muted); white-space: nowrap;
    font-variant-numeric: tabular-nums; flex: none;
  }
  /* Nunca jogado fica discreto: é oferta, não pendência. */
  .game-cheevos.empty { opacity: .55; }

  @media (max-width: 600px) {
    .game {
      grid-template-columns: 48px 1fr;
      grid-template-rows: auto auto auto;
    }
    .game-cover { grid-row: 1 / 4; }
    .game-title-row { grid-column: 2; grid-row: 1; }
    .media-row { grid-column: 2; grid-row: 2; }
    .game-cheevos {
      grid-column: 2; grid-row: 3;
      justify-self: stretch; height: auto; padding-top: var(--s-xs);
    }
    .media-toggle span { display: none; }
    .game-saves-link {
      grid-column: 3; grid-row: 1 / 4; align-self: center;
    }
    .game-saves-link span { display: none; }
  }
</style>
