---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Icon from '../../../../components/Icon.astro';
import { withBase } from '../../../../lib/base';
import { allGenerations, dexForGame, layoutForGame, boxesFor, gameName, spritePath, coverPath, platformsForGame } from '../../../../lib/pokemon';

export async function getStaticPaths() {
  const gens = allGenerations();
  return gens.flatMap((gen) =>
    gen.games.map((g) => ({
      params: { game: g.slug },
      props: { genName: gen.name, game: g.slug },
    })),
  );
}

interface Props {
  genName: string;
  game: string;
}
const { genName, game } = Astro.props;

const entries = dexForGame(genName, game);
const layout = layoutForGame(game);
const boxes = boxesFor(entries, layout);
const showBoxes = layout.type !== 'infinite-list' && boxes.length > 1;
const platforms = platformsForGame(genName, game);
---

<BaseLayout title={`${gameName(game)} — save`} description={`Save e pokédex de ${gameName(game)}`}>
  <a class="back" href={withBase('hobbies/pokemon/saves')}>← saves</a>

  <header
    class="doc-header save-hero"
    data-saves-root
    data-game={game}
    data-game-label={gameName(game)}
    data-game-platforms={JSON.stringify(platforms)}>
    <img
      class="save-hero-cover"
      src={withBase(coverPath(game))}
      alt=""
      width="400"
      height="400"
      decoding="async" />
    <div>
      <h1>{gameName(game)}</h1>
      <p class="hint save-trainer-line" data-trainer-line hidden>
        <span data-trainer-name></span> - <span data-trainer-id></span><span data-trainer-platform></span>
      </p>
    </div>
  </header>

  <p class="hint" data-no-save-msg hidden>
    Nenhum save selecionado. <a href={withBase('hobbies/pokemon/saves')}>Volte para a lista de saves</a> e escolha um.
  </p>

  <div data-dex-wrap hidden>
    <div class="active-save-info">
      <button class="icon-btn moved-home-btn" type="button" data-moved-home title="Movido pro HOME" aria-label="Movido pro HOME">
        <Icon name="house" size={20} />
      </button>
      <div class="active-save-actions">
        <button class="icon-btn" type="button" data-rename-active title="Renomear" aria-label="Renomear">✎</button>
        <button class="icon-btn" type="button" data-delete-active title="Apagar" aria-label="Apagar">🗑</button>
        <button class="icon-btn" type="button" data-check-all title="Marcar todos" aria-label="Marcar todos">
          <svg viewBox="0 0 20 20" width="18" height="18" fill="none" aria-hidden="true">
            <path d="M4 10.5l4 4 8-9" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <button class="icon-btn" type="button" data-uncheck-all title="Desmarcar todos" aria-label="Desmarcar todos">
          <svg viewBox="0 0 20 20" width="18" height="18" fill="none" aria-hidden="true">
            <path d="M5 5l10 10M15 5L5 15" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
          </svg>
        </button>
      </div>
    </div>

    <div class="progress-wrap">
      <div
        class="progress"
        role="progressbar"
        aria-label="Progresso da pokédex"
        aria-valuemin="0"
        aria-valuemax="100"
        aria-valuenow="0"
        data-progress-track>
        <span data-progress-bar></span>
      </div>
      <span class="hint" data-progress-label>0/{entries.length} — 0%</span>
    </div>

    <div class="mon-search-wrapper">
      <Icon name="search" size={18} />
      <input
        class="mon-search"
        type="search"
        inputmode="search"
        autocomplete="off"
        placeholder="Buscar por nome ou número…"
        aria-label="Buscar pokémon por nome ou número"
        data-mon-search />
    </div>
    <p class="hint" data-mon-search-empty hidden>Nenhum pokémon encontrado.</p>

    <div class={`dex dex-${layout.type}`} data-dex style={`--cols:${layout.cols}; --rows:${layout.rows}`}>
      {boxes.map((box, i) => (
        <section class="box">
          {showBoxes && (
            <h2 class="box-title">
              Caixa {i + 1}
              <small>{layout.cols}×{layout.rows} · {box.length}/{layout.perBox}</small>
            </h2>
          )}
          <ul class="box-items">
            {box.map((e) => (
              <li class="mon" data-mon>
                <button type="button" class="mon-btn" data-caught={e.species} aria-pressed="false" aria-label={e.name}>
                  <img
                    src={withBase(spritePath(e.id))}
                    alt=""
                    width="96"
                    height="96"
                    loading="lazy"
                    decoding="async" />
                  <span class="mon-num">#{String(e.number).padStart(3, '0')}</span>
                  <span class="mon-name">{e.name}</span>
                </button>
              </li>
            ))}
            {Array.from({ length: layout.perBox - box.length }).map(() => (
              <li class="mon empty" aria-hidden="true"></li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </div>

  <script>
    import { initPokemonSavePage } from '../../../../lib/pokemon-client';
    initPokemonSavePage();
  </script>
</BaseLayout>

<style>
  /* ===== hero: capa do jogo + título + treinador ===== */
  .save-hero { display: flex; align-items: center; gap: var(--s-md); }
  .save-hero-cover {
    width: 72px; height: 72px; object-fit: contain; flex: none;
    background: var(--surface-2); border-radius: var(--r-md);
  }
  .save-hero h1 { margin: 0; }
  .save-trainer-line { margin: 4px 0 0; }

  /* ===== info + ações do save ativo ===== */
  .active-save-info {
    display: flex; align-items: center; justify-content: space-between; gap: var(--s-sm);
    flex-wrap: wrap; background: var(--surface); padding: var(--s-sm) var(--s-md);
  }
  .moved-home-btn {
    color: var(--muted); transition: color .15s ease;
  }
  .moved-home-btn[aria-pressed="true"] {
    color: #f59e0b;
  }
  .active-save-actions { display: flex; gap: var(--s-sm); }

  /* ===== progresso ===== */
  .progress-wrap { display: flex; align-items: center; gap: var(--s-md); margin-bottom: var(--s-lg); }
  .progress { flex: 1; height: 6px; background: var(--surface-2); border-radius: var(--r-pill); overflow: hidden; }
  .progress-wrap .hint { font-variant-numeric: tabular-nums; white-space: nowrap; }
  .progress span { display: block; height: 100%; width: 0; background: var(--accent); transition: width .2s ease; }

  /* ===== busca ===== */
  .mon-search-wrapper {
    display: flex; align-items: center; gap: 8px; margin-bottom: var(--s-lg);
    padding: 0 12px; background: var(--surface-2);
    border: 1px solid var(--hairline); border-radius: var(--r-md);
    color: var(--muted);
  }

  .mon-search-wrapper :global(.icon) {
    font-size: 18px; flex: none;
  }

  .mon-search {
    display: block; flex: 1; margin-bottom: 0;
    padding: 10px 0; font: inherit; font-size: 16px;
    color: var(--ink); background: transparent;
    border: none;
  }
  .mon-search:focus { outline: none; }
  .mon-search::placeholder { color: var(--muted); }
  .mon-search::-webkit-search-cancel-button { cursor: pointer; }

  /* ===== caixas =====
     3 níveis de contraste: fundo da página (--bg) → caixa (--surface) →
     card de cada pokémon (--surface-2). Sem isso a caixa e os cards se
     confundiam com o fundo. */
  .box {
    margin-bottom: var(--s-lg);
    background: var(--surface); border: 1px solid var(--hairline);
    border-radius: var(--r-lg); padding: var(--s-md);
  }
  .box-title {
    font-size: 13px; font-weight: 600; color: var(--muted);
    text-transform: uppercase; letter-spacing: 0.04em; margin: 0 0 var(--s-sm);
    display: flex; align-items: baseline; gap: 8px;
  }
  .box-title small { font-weight: 400; text-transform: none; letter-spacing: 0; font-variant-numeric: tabular-nums; }
  .box-items { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-sm); }

  /* Grade de caixa: colunas E linhas vêm do box-layout.json e valem em
     qualquer largura — a caixa tem a forma que o jogo tem (ex.: 6×5 = 30).
     Em tela estreita a caixa encolhe até um mínimo e então rola na horizontal,
     em vez de mudar o número de colunas. */
  .dex-graphic-grid .box { overflow-x: auto; }
  .dex-graphic-grid .box-items {
    grid-template-columns: repeat(var(--cols), minmax(58px, 1fr));
    grid-auto-rows: 1fr;
    min-width: min-content;
  }
  .dex-graphic-grid .mon-btn {
    display: flex; flex-direction: column; align-items: center; gap: 2px;
    padding: var(--s-sm) 4px; text-align: center;
  }
  .dex-graphic-grid .mon-name {
    font-size: 11px; line-height: 1.2;
    overflow-wrap: anywhere;
  }

  /* lista (gen 1/2 e Let's Go): uma coluna, sprite ao lado do nome */
  .dex-icon-list .box-items,
  .dex-infinite-list .box-items { grid-template-columns: 1fr; gap: 0; }
  .dex-icon-list .mon-btn,
  .dex-infinite-list .mon-btn {
    display: flex; align-items: center; gap: var(--s-sm);
    padding: 5px var(--s-sm); text-align: left;
    background: transparent !important;
  }
  .dex-icon-list .mon-btn:hover,
  .dex-infinite-list .mon-btn:hover {
    background: transparent !important;
  }
  .dex-icon-list .mon + .mon,
  .dex-infinite-list .mon + .mon { border-top: 1px solid var(--hairline); }
  .dex-icon-list .mon img,
  .dex-infinite-list .mon img { width: 40px; height: 40px; }
  .dex-icon-list .mon-name,
  .dex-infinite-list .mon-name { flex: 1; font-size: 15px; }

  /* Botão sem chrome de botão: só a área clicável em volta do sprite.
     Marcar/desmarcar é o próprio clique — a cor do sprite já denota o
     estado, sem precisar de checkbox. */
  .mon-btn {
    display: flex; width: 100%; font: inherit; color: inherit;
    cursor: pointer; border-radius: var(--r-md);
    border: 1px solid transparent; background: var(--surface-2); user-select: none;
    -webkit-tap-highlight-color: transparent;
    transition: background .15s ease;
  }
  .mon-btn:hover { background: color-mix(in srgb, var(--accent) 6%, var(--surface-2)); }
  .mon-btn:focus-visible { outline: 2px solid var(--accent-focus); outline-offset: 2px; }
  .mon img {
    width: 72px; height: 72px; object-fit: contain; display: block;
    image-rendering: pixelated; /* sprites são pixel art: nada de borrar ao escalar */
    opacity: .35; filter: grayscale(1);
    transition: opacity .15s ease, filter .15s ease;
  }
  .mon-num { font-size: 11px; color: var(--muted); font-variant-numeric: tabular-nums; }

  /* pego: sprite ganha cor */
  .mon.caught img { opacity: 1; filter: none; }
  .mon.caught .mon-btn { background: color-mix(in srgb, var(--accent) 12%, var(--surface-2)); }
  .mon.caught .mon-name { font-weight: 600; }

  /* Vaga vazia: caixa sempre com o tamanho cheio (ex.: 30), mesmo quando o
     jogo não tem pokémon suficiente pra preencher a última — completa com
     slots em branco em vez de deixar a grade torta. */
  .mon.empty {
    border: 1px dashed var(--hairline); border-radius: var(--r-md);
    background: var(--surface-2); opacity: .5;
  }
  .dex-graphic-grid .mon.empty { aspect-ratio: 1 / 1; }
  .dex-icon-list .mon.empty,
  .dex-infinite-list .mon.empty { min-height: 50px; }

  /* Em tela estreita, só na grade (várias colunas): sem nome/número (a cor
     do sprite já diz o estado), a caixa some e a imagem cresce um pouco pra
     aproveitar o espaço. Colunas nunca mudam, só a célula — regra de sempre.
     Na lista de 1 coluna (gen 1/2, Let's Go) sobra espaço de sobra pro nome
     e número, então eles continuam aparecendo. */
  @media (max-width: 600px) {
    .dex-graphic-grid .box-items {
      grid-template-columns: repeat(var(--cols), minmax(48px, 1fr));
      gap: 3px;
    }
    .dex-graphic-grid .mon img { width: 48px; height: 48px; }
    .dex-graphic-grid .mon-btn { padding: 6px 2px; }
    .dex-graphic-grid .mon-num,
    .dex-graphic-grid .mon-name { display: none; }
  }
</style>
